/target
/dist
*.exe
*.pdb

# Real office documents are never committed. They routinely carry personal data
# in the file itself - author name, editing history, comments, tracked changes -
# and a public repository is the wrong place for any of it. Test documents used
# by the suite are generated by code instead.
*.doc
*.docx
*.docm
*.dot
*.dotx
*.dotm
*.rtf
*.odt
*.pdf

# Drop real Word files here to compare rendering against; the contents are
# ignored, so nothing leaves the machine. Only the explanatory README is tracked.
/corpus/*
!/corpus/README.md
